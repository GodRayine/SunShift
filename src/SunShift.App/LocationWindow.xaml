<Window x:Class="SunShift.App.LocationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Местоположение" Width="620" SizeToContent="Height"
    ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Где находится компьютер?" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,20"/>
      <RadioButton x:Name="WindowsMode" Content="Определять через Windows" IsChecked="True" Margin="0,0,0,14"/>
      <TextBlock Text="При применении Windows запросит разрешение, если решение ещё не принято. Позиция нужна только для расчёта рассвета и заката." Style="{StaticResource Secondary}" FontSize="12" Margin="22,0,0,16"/>
      <RadioButton x:Name="ManualMode" Content="Указать координаты вручную" Margin="0,0,0,14"/>
      <Grid IsEnabled="{Binding IsChecked, ElementName=ManualMode}">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Широта" Margin="0,0,0,6"/><TextBox x:Name="Latitude" Padding="10,8" AutomationProperties.Name="Широта"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Долгота" Margin="0,0,0,6"/><TextBox x:Name="Longitude" Padding="10,8" AutomationProperties.Name="Долгота"/></StackPanel>
      </Grid>
      <TextBlock Text="Координаты хранятся только в памяти до выхода из SunShift. После запуска позиция Windows определяется заново; ручные координаты нужно ввести повторно. Допустимы точка и запятая."
          Style="{StaticResource Secondary}" FontSize="12" Margin="0,14,0,0"/>
      <RadioButton x:Name="DisabledMode" Content="Не использовать местоположение" Margin="0,18,0,0"/>
      <TextBlock Text="Позиция будет забыта, автоматика остановится. Фоны можно применять вручную." Style="{StaticResource Secondary}" FontSize="12" Margin="22,8,0,0"/>
      <WrapPanel Margin="0,16,0,0">
        <Button Content="Разрешения Windows" Click="Privacy_Click" Margin="0,0,10,0"/>
        <Button Content="Конфиденциальность" Click="Policy_Click"/>
      </WrapPanel>
      <TextBlock x:Name="Error" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Отмена" IsCancel="True" Padding="16,8" Margin="0,0,10,0"/>
      <Button Content="Применить" IsDefault="True" Click="Save_Click" Style="{StaticResource Primary}"/>
    </StackPanel>
  </Grid>
</Window>

<Window x:Class="SunShift.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SunShift" Icon="Assets/SunShift.ico"
    Width="1020" Height="850" MinWidth="860" MinHeight="650" WindowStartupLocation="CenterScreen">
  <Grid Margin="28,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="SunShift" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="День и ночь — по солнцу" Style="{StaticResource Secondary}" Margin="0,4,0,0"/></StackPanel>
      <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,12" VerticalAlignment="Center">
        <CheckBox x:Name="AutoToggle" Content="{Binding AutomationLabel}" IsChecked="{Binding Automatic, Mode=OneWay}" Click="Automatic_Click" AutomationProperties.Name="Автоматическая смена дневного и ночного фона"/>
      </Border>
    </Grid>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border Style="{StaticResource Card}" Padding="22,16">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="48" Height="48" CornerRadius="13" Background="{DynamicResource Inset}" VerticalAlignment="Top">
                <TextBlock Text="{Binding PhaseGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding PhaseLabel}" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding RegionLabel}" Style="{StaticResource Secondary}" Margin="0,5,0,0"/>
                <TextBlock Text="{Binding CoordinatesLabel}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,5,0,0"/>
              </StackPanel>
              <Button Grid.Column="2" Content="Местоположение…" Click="Location_Click" IsEnabled="{Binding Ready}" Padding="12,7" VerticalAlignment="Top" Margin="10,2,0,0"/>
            </Grid>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Рассвет" Style="{StaticResource Secondary}" FontSize="12"/><TextBlock Text="{Binding Sunrise}" FontSize="23" Margin="0,3,0,0"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Закат" Style="{StaticResource Secondary}" FontSize="12"/><TextBlock Text="{Binding Sunset}" FontSize="23" Margin="0,3,0,0"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Следующее переключение" Style="{StaticResource Secondary}" FontSize="12"/><TextBlock Text="{Binding Next}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding AstronomyNote}" Style="{StaticResource Secondary}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
            </Grid>
          </Grid>
        </Border>
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="16">
            <StackPanel>
              <TextBlock Text="День" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="От рассвета до заката" Style="{StaticResource Secondary}" FontSize="12" Margin="0,3,0,14"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                  <Grid Height="110" Background="{DynamicResource Inset}">
                    <Image Source="{Binding DayDesktop, Converter={StaticResource Preview}}" Stretch="UniformToFill" ClipToBounds="True"/>
                    <TextBlock Text="Текущий фон" Style="{StaticResource Secondary}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding EmptyDayDesktop, Converter={StaticResource Visible}}"/>
                  </Grid>
                  <TextBlock Text="Рабочий стол" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,7"/>
                  <Button Content="Выбрать" Tag="DayDesktop" Click="Choose_Click" IsEnabled="{Binding Ready}" Padding="8,6"/>
                  <Button Content="Оставить текущий" Tag="DayDesktop" Click="Clear_Click" IsEnabled="{Binding Ready}" Padding="4,4" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <Grid Height="110" Background="{DynamicResource Inset}">
                    <Image Source="{Binding DayLock, Converter={StaticResource Preview}}" Stretch="UniformToFill" ClipToBounds="True"/>
                    <TextBlock Text="Текущий фон" Style="{StaticResource Secondary}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding EmptyDayLock, Converter={StaticResource Visible}}"/>
                  </Grid>
                  <TextBlock Text="Экран блокировки" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,7"/>
                  <Button Content="Выбрать" Tag="DayLock" Click="Choose_Click" IsEnabled="{Binding Ready}" Padding="8,6"/>
                  <Button Content="Оставить текущий" Tag="DayLock" Click="Clear_Click" IsEnabled="{Binding Ready}" Padding="4,4" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
              </Grid>
              <Button Content="Применить дневной фон" Tag="Day" Click="Apply_Click" IsEnabled="{Binding CanApplyDay}" Padding="12,8" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
            <StackPanel>
              <TextBlock Text="Ночь" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="От заката до рассвета" Style="{StaticResource Secondary}" FontSize="12" Margin="0,3,0,14"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                  <Grid Height="110" Background="{DynamicResource Inset}">
                    <Image Source="{Binding NightDesktop, Converter={StaticResource Preview}}" Stretch="UniformToFill" ClipToBounds="True"/>
                    <TextBlock Text="Текущий фон" Style="{StaticResource Secondary}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding EmptyNightDesktop, Converter={StaticResource Visible}}"/>
                  </Grid>
                  <TextBlock Text="Рабочий стол" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,7"/>
                  <Button Content="Выбрать" Tag="NightDesktop" Click="Choose_Click" IsEnabled="{Binding Ready}" Padding="8,6"/>
                  <Button Content="Оставить текущий" Tag="NightDesktop" Click="Clear_Click" IsEnabled="{Binding Ready}" Padding="4,4" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <Grid Height="110" Background="{DynamicResource Inset}">
                    <Image Source="{Binding NightLock, Converter={StaticResource Preview}}" Stretch="UniformToFill" ClipToBounds="True"/>
                    <TextBlock Text="Текущий фон" Style="{StaticResource Secondary}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding EmptyNightLock, Converter={StaticResource Visible}}"/>
                  </Grid>
                  <TextBlock Text="Экран блокировки" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,7"/>
                  <Button Content="Выбрать" Tag="NightLock" Click="Choose_Click" IsEnabled="{Binding Ready}" Padding="8,6"/>
                  <Button Content="Оставить текущий" Tag="NightLock" Click="Clear_Click" IsEnabled="{Binding Ready}" Padding="4,4" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
              </Grid>
              <Button Content="Применить ночной фон" Tag="Night" Click="Apply_Click" IsEnabled="{Binding CanApplyNight}" Padding="12,8" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
        <TextBlock Text="Автоматика следует солнцу. Ручное применение ставит её на паузу; пустое изображение сохраняет текущий фон экрана."
            Style="{StaticResource Secondary}" FontSize="12" Margin="2,12,2,0"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxHeight="90" FontSize="12"/>
          <CheckBox Content="Запускать с Windows" IsChecked="{Binding StartupEnabled, Mode=OneWay}" Click="Startup_Click" Margin="0,9,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <Button Content="Обновить геопозицию и расчёт" Click="Refresh_Click" IsEnabled="{Binding Ready}" Padding="12,7"/>
          <Button Content="Параметры геолокации Windows" Click="Privacy_Click" Padding="8,4" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>

<Window x:Class="SunShift.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="SunShift"
        Icon="Assets/SunShift.ico" Width="1120" Height="980" MinWidth="600" MinHeight="600"
        WindowStartupLocation="CenterScreen" SizeChanged="Window_SizeChanged" StateChanged="Window_StateChanged" WindowStyle="None">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="70" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource AppButton}"/>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="40"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Inset}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Surface}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Text}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="OuterFrame" Background="{DynamicResource Page}" BorderBrush="{DynamicResource Outline}" BorderThickness="1">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Margin="24,0,8,0" Background="Transparent">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="{DynamicResource Inset}" CornerRadius="10" Width="36" Height="36" Margin="0,0,12,0">
          <Path Data="M3,12 A9,9 0 1 0 15,3 A7,7 0 1 1 3,12" Stroke="{DynamicResource Text}" StrokeThickness="1.5" Stretch="Uniform" Width="20" Height="20" IsHitTestVisible="False"/>
        </Border>
        <StackPanel><TextBlock Text="SunShift" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="Обои в ритме солнца" Style="{StaticResource Secondary}" FontSize="12"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <TextBlock Text="Тема интерфейса" Style="{StaticResource Secondary}" FontSize="12" Margin="0,0,0,4"/>
        <ComboBox x:Name="ThemePicker" Width="156" SelectionChanged="Theme_Changed" SelectedIndex="{Binding ThemeIndex, Mode=OneWay}" IsEnabled="{Binding Ready}" AutomationProperties.Name="Тема интерфейса"
                  Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Outline}"/>
      </StackPanel>
      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,0,0">
        <Button x:Name="ExitButton" Content="Выйти" Height="40" Margin="0,0,8,0" Click="Exit_Click" ToolTip="Полностью закрыть SunShift" AutomationProperties.Name="Выйти из SunShift и завершить работу в трее" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Свернуть" AutomationProperties.Name="Свернуть окно"/>
        <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Развернуть" AutomationProperties.Name="Развернуть окно"/>
        <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="Скрыть в трей" AutomationProperties.Name="Закрыть окно"/>
      </StackPanel>
    </Grid>
  <ScrollViewer Grid.Row="1" Background="{DynamicResource Page}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,8,24,24"
                KeyboardNavigation.TabNavigation="Continue">
    <StackPanel x:Name="ContentStack" MaxWidth="1220">
      <Border Style="{StaticResource Card}" Margin="0,0,0,20">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource Inset}" Margin="0,0,20,0">
              <TextBlock Text="{Binding PhaseGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1"><TextBlock Text="{Binding PhaseLabel}" TextWrapping="Wrap" FontSize="36" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding RegionLabel}" Style="{StaticResource Secondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="16,0,0,0">
              <TextBlock Text="{Binding LocalClock}" FontSize="32" HorizontalAlignment="Right"/>
              <TextBlock Text="{Binding LocalDate}" Style="{StaticResource Secondary}" FontSize="12"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Рассвет" Style="{StaticResource Secondary}" FontSize="12"/>
              <TextBlock Text="{Binding Sunrise}" FontSize="24" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Закат" Style="{StaticResource Secondary}" FontSize="12"/>
              <TextBlock Text="{Binding Sunset}" FontSize="24" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="{Binding NextLabel}" Style="{StaticResource Secondary}" FontSize="12"/>
              <TextBlock Text="{Binding NextTime}" FontSize="24" Margin="0,4,0,0"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Grid x:Name="BodyGrid">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="MainColumn" Width="*"/><ColumnDefinition x:Name="GapColumn" Width="24"/><ColumnDefinition x:Name="SideColumn" Width="300"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="ProfileCard" Style="{StaticResource Card}" VerticalAlignment="Top">
          <StackPanel>
            <Border Background="{DynamicResource Inset}" CornerRadius="10" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,16">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="DayTab" Content="День" GroupName="Profile" Style="{StaticResource Segment}" IsChecked="{Binding SelectedDay, Mode=TwoWay}" Click="Profile_Click" AutomationProperties.Name="Дневной профиль"/>
                <RadioButton x:Name="NightTab" Content="Ночь" GroupName="Profile" Style="{StaticResource Segment}" IsChecked="{Binding SelectedNight, Mode=TwoWay}" Click="Profile_Click" AutomationProperties.Name="Ночной профиль"/>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding ProfileTitle}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ProfileSubtitle}" Style="{StaticResource Secondary}" Margin="0,4,0,16"/>
            <TextBlock Text="{Binding RotationSummary}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,0,0,16"/>
            <Grid x:Name="PreviewGrid">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Рабочий стол" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Border CornerRadius="10" Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" ClipToBounds="True">
                  <Grid Height="150" ClipToBounds="True">
                    <Image Source="{Binding DesktopImage, Converter={StaticResource Preview}}" Stretch="UniformToFill" AutomationProperties.Name="Предпросмотр рабочего стола"/>
                    <StackPanel Visibility="{Binding EmptyDesktop, Converter={StaticResource Visible}}" VerticalAlignment="Center" Margin="16">
                      <TextBlock Text="Текущий фон" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                      <TextBlock Text="Останется без изменений" Style="{StaticResource Secondary}" FontSize="12" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <Button x:Name="ChooseDesktop" Content="Выбрать изображение" Tag="{Binding DesktopTarget}" IsEnabled="{Binding CanEditSingle}" Visibility="{Binding SingleSourceMode, Converter={StaticResource Visible}}" Click="Choose_Click" Margin="0,12,0,0" AutomationProperties.Name="Выбрать изображение рабочего стола"/>
                <Button Content="Оставить текущий" Tag="{Binding DesktopTarget}" IsEnabled="{Binding CanEditSingle}" Visibility="{Binding SingleSourceMode, Converter={StaticResource Visible}}" Click="Clear_Click" Margin="0,8,0,0" AutomationProperties.Name="Сбросить изображение рабочего стола"/>
                <TextBlock Text="{Binding DesktopError}" Style="{StaticResource InlineError}"/>
                <TextBlock Text="{Binding DesktopSourceLabel}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Экран блокировки" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Border CornerRadius="10" Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" ClipToBounds="True">
                  <Grid Height="150" ClipToBounds="True">
                    <Image Source="{Binding LockImage, Converter={StaticResource Preview}}" Stretch="UniformToFill" AutomationProperties.Name="Предпросмотр экрана блокировки"/>
                    <Border Visibility="{Binding ShowLockClock, Converter={StaticResource Visible}}" Background="{StaticResource ImageLabelOverlay}" VerticalAlignment="Top" HorizontalAlignment="Left" CornerRadius="6" Margin="12" Padding="8,4">
                      <TextBlock Text="{Binding LocalClock}" Foreground="White" FontSize="20"/>
                    </Border>
                    <StackPanel Visibility="{Binding EmptyLock, Converter={StaticResource Visible}}" VerticalAlignment="Center" Margin="16">
                      <TextBlock Text="Текущий фон" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                      <TextBlock Text="Останется без изменений" Style="{StaticResource Secondary}" FontSize="12" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <Button Content="Выбрать изображение" Tag="{Binding LockTarget}" IsEnabled="{Binding CanEditSingle}" Visibility="{Binding SingleSourceMode, Converter={StaticResource Visible}}" Click="Choose_Click" Margin="0,12,0,0" AutomationProperties.Name="Выбрать изображение экрана блокировки"/>
                <Button x:Name="ClearLock" Content="Оставить текущий" Tag="{Binding LockTarget}" IsEnabled="{Binding CanEditSingle}" Visibility="{Binding SingleSourceMode, Converter={StaticResource Visible}}" Click="Clear_Click" Margin="0,8,0,0" AutomationProperties.Name="Сбросить изображение экрана блокировки"/>
                <TextBlock Text="{Binding LockError}" Style="{StaticResource InlineError}"/>
                <TextBlock Text="{Binding LockSourceLabel}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,0"/>
              </StackPanel>
            </Grid>
            <WrapPanel Margin="0,20,0,0">
              <Button x:Name="ApplyButton" Content="Применить выбранный фон" Tag="{Binding SelectedPhaseTag}" Style="{StaticResource Primary}" Click="Apply_Click" IsEnabled="{Binding CanApplySelected}" Margin="0,0,12,8"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <StackPanel x:Name="SidePanel" Grid.Column="2">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Автоматическая смена обоев" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,16"/>
              <CheckBox x:Name="AutoToggle" Content="{Binding AutomationLabel}" IsChecked="{Binding Automatic, Mode=OneWay}"
                        Click="Automatic_Click" AutomationProperties.Name="Автоматическая смена обоев по рассвету и закату"/>
              <TextBlock Text="Дневной профиль на рассвете, ночной — на закате." Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,16"/>
              <CheckBox Content="Запускать с Windows" IsChecked="{Binding StartupEnabled, Mode=OneWay}" Click="Startup_Click" IsEnabled="{Binding Ready}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="Коллекция обоев" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="Дополнительная настройка" Style="{StaticResource Secondary}" FontSize="12" Margin="0,4,0,12"/>
              <CheckBox x:Name="RotationToggle" Content="Менять по интервалу" IsChecked="{Binding RotateCollection, Mode=OneWay}" Click="RotationToggle_Click" IsEnabled="{Binding Ready}" AutomationProperties.Name="Смена коллекции по интервалу"/>
              <TextBlock Text="{Binding CollectionSummary}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,12"/>
              <Button x:Name="CollectionButton" Content="Настроить коллекцию…" Click="Collection_Click" IsEnabled="{Binding Ready}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="Местоположение" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding LocationSource}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,6,0,0"/>
              <TextBlock Text="{Binding CoordinatesLabel}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,16"/>
              <Button x:Name="RefreshButton" Content="{Binding RefreshLabel}" Click="Refresh_Click" IsEnabled="{Binding Ready}"/>
              <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource Visible}}" Margin="0,8,0,0" AutomationProperties.Name="Выполняется расчёт или обновление"/>
              <Button Content="Источник и координаты…" Click="Location_Click" IsEnabled="{Binding Ready}" Margin="0,8,0,0"/>
              <Button Content="Параметры Windows" Click="Privacy_Click" Margin="0,8,0,0" AutomationProperties.Name="Открыть параметры геолокации Windows"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding AstronomyNote}" Style="{StaticResource Secondary}" FontSize="12" Margin="4,16,4,0"/>
        </StackPanel>
      </Grid>

      <Border Background="{DynamicResource Inset}" CornerRadius="10" Padding="16,12" Margin="0,20,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0">
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Результат действия"/>
          <TextBlock Text="{Binding FooterHint}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,6,0,0"/>
        </StackPanel>
          <Button Grid.Column="1" Content="Лицензия" Click="License_Click" VerticalAlignment="Center" AutomationProperties.Name="О программе и GNU GPL"/>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
  </Grid>
  </Border>
</Window>

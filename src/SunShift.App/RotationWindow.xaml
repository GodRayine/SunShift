<Window x:Class="SunShift.App.RotationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Папки и смена обоев" Width="620" Height="700"
        MinWidth="480" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources><Style TargetType="Button" BasedOn="{StaticResource AppButton}"/></Window.Resources>
  <Border Background="{DynamicResource Page}" Padding="24">
    <Grid>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Fields" Margin="0,0,0,16">
          <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="Выберите папки для этого профиля. Если папка не задана, используется выбранное одиночное изображение." Style="{StaticResource Secondary}" Margin="0,8,0,24"/>
          <Label Content="Папка рабочего стола" Target="{Binding ElementName=DesktopFolder}" Padding="0" FontWeight="SemiBold"/>
          <TextBox x:Name="DesktopFolder" Margin="0,8,0,8" Padding="8" AutomationProperties.Name="Папка рабочего стола"/>
          <WrapPanel><Button Content="Выбрать папку…" Tag="Desktop" Click="Browse_Click" Margin="0,0,8,0"/><Button Content="Без папки" Tag="Desktop" Click="Clear_Click"/></WrapPanel>
          <TextBlock x:Name="DesktopValidation" Style="{StaticResource InlineError}"/>
          <Label Content="Папка экрана блокировки" Target="{Binding ElementName=LockFolder}" Padding="0" FontWeight="SemiBold" Margin="0,20,0,0"/>
          <TextBox x:Name="LockFolder" Margin="0,8,0,8" Padding="8" AutomationProperties.Name="Папка экрана блокировки"/>
          <WrapPanel><Button Content="Выбрать папку…" Tag="Lock" Click="Browse_Click" Margin="0,0,8,0"/><Button Content="Без папки" Tag="Lock" Click="Clear_Click"/></WrapPanel>
          <TextBlock x:Name="LockValidation" Style="{StaticResource InlineError}"/>
          <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><Label Content="Интервал" Target="{Binding ElementName=Interval}" Padding="0" FontWeight="SemiBold"/>
              <ComboBox x:Name="Interval" IsEditable="True" IsTextSearchEnabled="False" Margin="0,8,0,0" AutomationProperties.Name="Интервал смены обоев"/>
              <TextBlock Text="Своё значение — в минутах (1–1440)" Style="{StaticResource Secondary}" FontSize="12" Margin="0,6,0,0"/>
              <TextBlock x:Name="IntervalValidation" Style="{StaticResource InlineError}"/>
            </StackPanel>
            <StackPanel Grid.Column="2"><Label Content="Порядок" Target="{Binding ElementName=Order}" Padding="0" FontWeight="SemiBold"/>
              <ComboBox x:Name="Order" Margin="0,8,0,0" AutomationProperties.Name="Порядок смены обоев"/>
              <TextBlock Text="Случайный — без повтора предыдущего кадра" Style="{StaticResource Secondary}" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="JPG, PNG и BMP в выбранной папке, без подпапок. При рассвете или закате сразу включается соответствующий профиль. Пауза останавливает и смену по интервалу." Style="{StaticResource Secondary}" FontSize="12" Margin="0,24,0,0"/>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Feedback" Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Отмена" IsCancel="True" Margin="0,0,8,0"/>
          <Button x:Name="SaveButton" Content="Сохранить" IsDefault="True" Style="{StaticResource Primary}" Click="Save_Click"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
